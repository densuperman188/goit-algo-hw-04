def get_cats_info(path):
    cats = []
    try:
        with open(path, 'r', encoding='utf-8') as file:
            for line in file:
                cat_id, name, age = line.split(',')
                cat = {
                    'id': int(cat_id),
                    'name': name.strip(),
                    'age': int(age)
                }
            cats.append(cat)
    except FileNotFoundError:
        return []
    return cats